<?xml version="1.0" encoding="UTF-8"?>
<modification>
	<name>SStock Report</name>
	<version>1.1.0</version>
	<code>Stock Report</code>
	<author>shijinbgopal@gmail.com</author>
	<link>https://natureloc.com</link>

	<file path="admin/controller/report/report.php">
		<operation>
			<search><![CDATA[foreach ($data['reports'] as $key => $value) {]]></search>
			<add position="before"><![CDATA[
              $custom_reports=array(
			'text'       => "Stock Report",
			'code'       => "stock_report",
			'sort_order' => 0,
			'href'       => $this->url->link('report/report', 'user_token=' . $this->session->data['user_token'] . '&code=stock_report', true)
		);
		$this->load->language('extension/report/stock_report','extension');
		array_push($data['reports'],$custom_reports);
        ]]></add>
		</operation>
	</file>
</modification>
