        <div class="form-group">
          <label class="control-label" for="input-date-end">{{ entry_product_name }}</label>
          <div class="input-group date">
            <input type="text" name="filter_product_name" value="{{ filter_name }}" placeholder="{{ entry_product_name }}" id="filter_product_name" class="form-control" />
          </div>
        </div>
        <div class="form-group text-right">
          <a target="_blank" style="float: left;" href="{{ export }}" data-toggle="tooltip" title={{ button_export }} class="btn btn-success"><i class="fa fa-download"></i></a>
          <button type="button" id="button-filter" class="btn btn-default"><i class="fa fa-filter"></i> {{ button_filter }}</button>
        </div>
      </div>
    </div>
  </div>
  <div class="col-md-9 col-md-pull-3 col-sm-12">
    <div class="panel panel-default">
      <div class="panel-heading">
        <h3 class="panel-title"><i class="fa fa-bar-chart"></i> {{ heading_title }}</h3>
      </div>
      <div class="panel-body">
        <div class="table-responsive">
          <table class="table table-bordered">
            <thead>
              <tr>
                <td class="text-right">{{ column_name }}</td>
                <td class="text-right">{{ column_priority }}</td>
                <td class="text-right">{{ column_sku }}</td>
                <td class="text-right">{{ column_upc }}</td>
                <td class="text-left">{{ column_option }}</td>
                <td class="text-left">{{ column_stock }}</td>
                <td class="text-right">{{ column_price }}</td>
                <td class="text-right">{{ column_model }}</td>
                <td class="text-left">{{ column_manufacturer }}</td>
                <td class="text-left">{{ column_shipping }}</td>
                <td class="text-left">{{ column_status }}</td>
                <td class="text-left">{{ column_tax_class_id }}</td>
                <td class="text-left">{{ column_keep_selling_flag }}</td>
              </tr>
            </thead>
            <tbody>
            {% if products %}
            {% for product in products %}
            <tr>
              <td class="text-left">{{ product.name }}</td>
              <td class="text-left">{{ product.product_priority }}</td>
              <td class="text-right">{{ product.sku }}</td>
              <td class="text-right">{{ product.upc }}</td>
              <td class="text-right">{{ product.option_name}}</td>
              <td class="text-right">{{ product.quantity }}</td>
              <td class="text-left">{{ product.option_price }}</td>
              <td class="text-left">{{ product.model }}</td>
              <td class="text-right">{{ product.manufacturer }}</td>
              <td class="text-right">{{ product.shipping }}</td>
              <td class="text-right">{{ product.product_status }}</td>
              <td class="text-right">{{ product.tax_class_id }}</td>
              <td class="text-right">{{ product.keep_selling }}</td>
            </tr>
            {% endfor %}
            {% else %}
            <tr>
              <td class="text-center" colspan="6">{{ text_no_results }}</td>
            </tr>
            {% endif %}
            </tbody>
            
          </table>
        </div>
        <div class="row">
          <div class="col-sm-6 text-left">{{ pagination }}</div>
          <div class="col-sm-6 text-right">{{ results }}</div>
        </div>
      </div>
    </div>
  </div>
</div>
<script type="text/javascript"><!--
$('#button-filter').on('click', function() {
	var url = '';
	
  var filter_name = $('input[name=\'filter_product_name\']').val();

  if (filter_name) {
    url += '&filter_name=' + encodeURIComponent(filter_name);
  }
  
	var filter_date_start = $('input[name=\'filter_date_start\']').val();
	
	if (filter_date_start) {
		url += '&filter_date_start=' + encodeURIComponent(filter_date_start);
	}

	var filter_date_end = $('input[name=\'filter_date_end\']').val();
	
	if (filter_date_end) {
		url += '&filter_date_end=' + encodeURIComponent(filter_date_end);
	}
		
	var filter_group = $('select[name=\'filter_group\']').val();
	
	if (filter_group) {
		url += '&filter_group=' + encodeURIComponent(filter_group);
	}
	
	// var filter_order_status_id = $('select[name=\'filter_order_status_id\']').val();
	
	// if (filter_order_status_id != 0) {
	// 	url += '&filter_order_status_id=' + encodeURIComponent(filter_order_status_id);
	// }	

	location = 'index.php?route=report/report&code=stock_report&user_token={{ user_token }}' + url;
});

$('input[name=\'filter_product_name\']').autocomplete({
  'source': function(request, response) {
    $.ajax({
      url: 'index.php?route=catalog/product/autocomplete&user_token={{ user_token }}&filter_name=' +  encodeURIComponent(request),
      dataType: 'json',
      success: function(json) {
        response($.map(json, function(item) {
          return {
            label: item['name'],
            value: item['product_id']
          }
        }));
      }
    });
  },
  'select': function(item) {
    $('input[name=\'filter_product_name\']').val(item['label']);
  }
});

//--></script> 
<script type="text/javascript"><!--
$('.date').datetimepicker({
	language: '{{ datepicker }}',
	pickTime: false
});
