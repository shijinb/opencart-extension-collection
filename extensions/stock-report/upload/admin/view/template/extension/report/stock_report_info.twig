<div class="row">
  <div id="filter-report" class="col-md-3 col-md-push-9 col-sm-12 hidden-sm hidden-xs">
    <div class="panel panel-default">
      <div class="panel-heading">
        <h3 class="panel-title"><i class="fa fa-filter"></i> {{ text_filter }}</h3>
      </div>
      <div class="panel-body">
        <div class="form-group">
          <label class="control-label" for="input-stock-name">{{ entry_name }}</label>
          <input type="text" name="filter_name" value="{{ filter_name }}" placeholder="{{ entry_name }}" id="input-stock-name" class="form-control" />
        </div>
        <div class="form-group">
          <label class="control-label" for="input-stock-quantity-max">{{ entry_quantity_max }}</label>
          <input type="number" name="filter_quantity_max" value="{{ filter_quantity_max }}" placeholder="{{ entry_quantity_max }}" id="input-stock-quantity-max" class="form-control" />
        </div>
        <div class="form-group text-right">
          <a href="{{ export }}" class="btn btn-success pull-left"><i class="fa fa-download"></i> {{ button_export }}</a>
          <button type="button" id="button-stock-filter" class="btn btn-default"><i class="fa fa-filter"></i> {{ button_filter }}</button>
        </div>
      </div>
    </div>
  </div>
  <div class="col-md-9 col-md-pull-3 col-sm-12">
    <div class="panel panel-default">
      <div class="panel-heading">
        <h3 class="panel-title"><i class="fa fa-bar-chart"></i> {{ heading_title }}</h3>
      </div>
      <div class="panel-body">
        <div class="table-responsive">
          <table class="table table-bordered">
            <thead>
              <tr>
                <td class="text-left">{{ column_name }}</td>
                <td class="text-left">{{ column_model }}</td>
                <td class="text-left">{{ column_sku }}</td>
                <td class="text-left">{{ column_option }}</td>
                <td class="text-right">{{ column_quantity }}</td>
                <td class="text-right">{{ column_price }}</td>
                <td class="text-left">{{ column_manufacturer }}</td>
                <td class="text-left">{{ column_status }}</td>
              </tr>
            </thead>
            <tbody>
              {% if products %}
              {% for product in products %}
              <tr>
                <td class="text-left"><a href="{{ product.edit }}">{{ product.name }}</a></td>
                <td class="text-left">{{ product.model }}</td>
                <td class="text-left">{{ product.sku }}</td>
                <td class="text-left">{{ product.option }}</td>
                <td class="text-right">{% if product.quantity <= 0 %}<span class="label label-danger">{{ product.quantity }}</span>{% elseif product.quantity <= 5 %}<span class="label label-warning">{{ product.quantity }}</span>{% else %}{{ product.quantity }}{% endif %}</td>
                <td class="text-right">{{ product.price }}</td>
                <td class="text-left">{{ product.manufacturer }}</td>
                <td class="text-left">{{ product.status }}</td>
              </tr>
              {% endfor %}
              {% else %}
              <tr>
                <td class="text-center" colspan="8">{{ text_no_results }}</td>
              </tr>
              {% endif %}
            </tbody>
          </table>
        </div>
        <div class="row">
          <div class="col-sm-6 text-left">{{ pagination }}</div>
          <div class="col-sm-6 text-right">{{ results }}</div>
        </div>
      </div>
    </div>
  </div>
</div>
<script type="text/javascript"><!--
$('#button-stock-filter').on('click', function() {
	var url = '';

	var filter_name = $('input[name=\'filter_name\']').val();

	if (filter_name) {
		url += '&filter_name=' + encodeURIComponent(filter_name);
	}

	var filter_quantity_max = $('input[name=\'filter_quantity_max\']').val();

	if (filter_quantity_max !== '') {
		url += '&filter_quantity_max=' + encodeURIComponent(filter_quantity_max);
	}

	location = 'index.php?route=report/report&code=stock_report&user_token={{ user_token }}' + url;
});
//--></script>
