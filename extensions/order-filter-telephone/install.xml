<?xml version="1.0" encoding="utf-8"?>
<modification>
	<name>Order List Filter: Telephone</name>
	<code>order_filter_telephone</code>
	<version>1.1.0</version>
	<author>Shijin</author>
	<link>https://github.com/shijinb/opencart-extension-collection</link>

	<!--
		Adds a "Telephone" filter to Sales > Orders, to look up a customer's orders by phone number.
		Matches the order's "telephone" column exactly.
	-->
	<file path="admin/language/en-gb/sale/order.php">
		<operation>
			<search><![CDATA[$_['entry_order_id']]]></search>
			<add position="after"><![CDATA[$_['entry_telephone'] = 'Telephone';]]></add>
		</operation>
	</file>
	<file path="admin/view/template/sale/order_list.twig">
		<operation>
			<search index="0"><![CDATA[<div class="panel-body">]]></search>
			<add position="after"><![CDATA[            <div class="form-group">
              <label class="control-label" for="input-telephone">{{ entry_telephone }}</label>
              <input type="text" name="filter_telephone" value="{{ filter_telephone }}" placeholder="{{ entry_telephone }}" id="input-telephone" class="form-control" />
            </div>]]></add>
		</operation>
		<operation>
			<search><![CDATA[var filter_order_id = $('input[name=\'filter_order_id\']').val();]]></search>
			<add position="after"><![CDATA[
	var filter_telephone = $('input[name=\'filter_telephone\']').val();

	if (filter_telephone) {
		url += '&filter_telephone=' + encodeURIComponent(filter_telephone);
	}]]></add>
		</operation>
	</file>
	<file path="admin/controller/sale/order.php">
		<operation>
			<search><![CDATA[protected function getList() {]]></search>
			<add position="after"><![CDATA[		if (isset($this->request->get['filter_telephone'])) {
			$filter_telephone = $this->request->get['filter_telephone'];
		} else {
			$filter_telephone = '';
		}
]]></add>
		</operation>
		<operation>
			<search><![CDATA['filter_order_id'        => $filter_order_id,]]></search>
			<add position="after"><![CDATA[			'filter_telephone' => $filter_telephone,]]></add>
		</operation>
		<operation>
			<!-- Every place that rebuilds the list URL (sorting, pagination, back links) keeps the filter. -->
			<search><![CDATA[$url .= '&filter_order_id=' . $this->request->get['filter_order_id'];]]></search>
			<add position="replace"><![CDATA[$url .= '&filter_order_id=' . $this->request->get['filter_order_id'];
		}

		if (isset($this->request->get['filter_telephone'])) {
			$url .= '&filter_telephone=' . urlencode(html_entity_decode($this->request->get['filter_telephone'], ENT_QUOTES, 'UTF-8'));]]></add>
		</operation>
		<operation>
			<search><![CDATA[$data['filter_order_id'] = $filter_order_id;]]></search>
			<add position="after"><![CDATA[		$data['filter_telephone'] = $filter_telephone;]]></add>
		</operation>
	</file>
	<file path="admin/model/sale/order.php">
		<operation>
			<!-- getOrders(): the order table is aliased as "o". -->
			<search><![CDATA[$sql .= " AND o.total = '" . (float)$data['filter_total'] . "'";]]></search>
			<add position="after"><![CDATA[		}

		if (!empty($data['filter_telephone'])) {
			$sql .= " AND o.telephone = '" . $this->db->escape($data['filter_telephone']) . "'";]]></add>
		</operation>
		<operation>
			<!-- getTotalOrders() and getTotalSales(): no table alias. -->
			<search><![CDATA[$sql .= " AND total = '" . (float)$data['filter_total'] . "'";]]></search>
			<add position="after"><![CDATA[		}

		if (!empty($data['filter_telephone'])) {
			$sql .= " AND telephone = '" . $this->db->escape($data['filter_telephone']) . "'";]]></add>
		</operation>
	</file>
</modification>
