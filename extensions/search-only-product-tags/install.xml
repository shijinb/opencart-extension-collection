<?xml version="1.0" encoding="utf-8"?>
<modification>
	<name>Search-Only Product Tags</name>
	<code>search_only_product_tags</code>
	<version>2.0.0</version>
	<author>Shijin</author>
	<link>https://github.com/shijinb/opencart-extension-collection</link>

	<!--
		Adds a "Search-only Tags" field to each product description. These keywords make the product
		findable in the storefront search (synonyms, common misspellings, local names) but, unlike
		the core "Product Tags", they are not displayed on the product page.

		Requires a new column. Run install.sql (replace "oc_" with your DB_PREFIX) before
		refreshing modifications.
	-->
	<file path="admin/language/en-gb/catalog/product.php">
		<operation>
			<search><![CDATA[$_['entry_tag']]]></search>
			<add position="after"><![CDATA[$_['entry_hidden_tag'] = 'Search-only Tags';
$_['help_hidden_tag'] = 'Comma separated. Matched by the storefront search but never shown to customers.';]]></add>
		</operation>
	</file>
	<file path="admin/view/template/catalog/product_form.twig">
		<operation>
			<search><![CDATA[<label class="col-sm-2 control-label" for="input-tag{{ language.language_id }}"><span data-toggle="tooltip" title="{{ help_tag }}">{{ entry_tag }}</span></label>]]></search>
			<add position="before"><![CDATA[                    <label class="col-sm-2 control-label" for="input-hidden-tag{{ language.language_id }}"><span data-toggle="tooltip" title="{{ help_hidden_tag }}">{{ entry_hidden_tag }}</span></label>
                    <div class="col-sm-10">
                      <input type="text" name="product_description[{{ language.language_id }}][hidden_tag]" value="{{ product_description[language.language_id] ? product_description[language.language_id].hidden_tag }}" placeholder="{{ entry_hidden_tag }}" id="input-hidden-tag{{ language.language_id }}" class="form-control" />
                    </div>
                  </div>
                  <div class="form-group">]]></add>
		</operation>
	</file>
	<file path="admin/model/catalog/product.php">
		<operation>
			<!-- addProduct() and editProduct() -->
			<search><![CDATA[tag = '" . $this->db->escape($value['tag']) . "',]]></search>
			<add position="replace"><![CDATA[tag = '" . $this->db->escape($value['tag']) . "', hidden_tag = '" . $this->db->escape(isset($value['hidden_tag']) ? $value['hidden_tag'] : '') . "',]]></add>
		</operation>
		<operation>
			<!-- getProductDescriptions(): load the saved value into the form (and into copyProduct()). -->
			<search><![CDATA['tag'              => $result['tag']]]></search>
			<add position="replace"><![CDATA['tag'              => $result['tag'],
				'hidden_tag'       => $result['hidden_tag']]]></add>
		</operation>
	</file>
	<file path="catalog/model/catalog/product.php">
		<operation>
			<!-- getProducts() and getTotalProducts(). Parentheses keep the OR inside each word's condition. -->
			<search><![CDATA[$implode[] = "pd.tag LIKE '%" . $this->db->escape($word) . "%'";]]></search>
			<add position="replace"><![CDATA[$implode[] = "(pd.tag LIKE '%" . $this->db->escape($word) . "%' OR pd.hidden_tag LIKE '%" . $this->db->escape($word) . "%')";]]></add>
		</operation>
	</file>
</modification>
