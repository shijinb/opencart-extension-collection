<?xml version="1.0" encoding="utf-8"?>
<modification>
	<name>Marketing Code Filter</name>
	<code>Marketing Code Filter</code>
	<version>1.0</version>
	<author>Shijin</author>
	<link>https://natureloc.com</link>

	<file path="admin/view/template/sale/order_list.twig" error="skip"  info="Marketing Code Filter in order page">
		<operation error="skip">
			<search index="0"><![CDATA[<div class="panel-body">]]></search>
			<add position="after"><![CDATA[
            <div class="form-group">
            <label class="control-label" for="input-marketing_code">{{ entry_marketing_code }}</label>
            <input type="text" name="filter_marketing_code" value="{{ filter_marketing_code }}" placeholder="{{ entry_marketing_code }}" id="input-marketing_code" class="form-control" />
        </div>
				]]></add>
		</operation>
		<operation error="skip">
			<search ><![CDATA[var filter_order_id = $('input[name=\'filter_order_id\']').val();]]></search>
			<add position="after"><![CDATA[
					var filter_marketing_code = $('input[name=\'filter_marketing_code\']').val();
					  if (filter_marketing_code) {
					    url += '&filter_marketing_code=' + encodeURIComponent(filter_marketing_code);
					  }
				]]></add>
		</operation>
	</file>
	<file path="admin/controller/sale/order.php" error="skip" >
		<operation error="skip">
			<search ><![CDATA[function getList() {]]></search>
			<add position="after"><![CDATA[
				if (isset($this->request->get['filter_marketing_code'])) {
			$filter_marketing_code = $this->request->get['filter_marketing_code'];
		} else {
			$filter_marketing_code = '';
		}
				]]></add>
		</operation>
		<operation error="skip">
			<search ><![CDATA[public function export() {]]></search>
			<add position="after"><![CDATA[
					if (isset($this->request->get['filter_marketing_code'])) {
			$filter_marketing_code = $this->request->get['filter_marketing_code'];
		} else {
			$filter_marketing_code = '';
		}
				]]></add>
		</operation>
		<operation error="skip">
			<search ><![CDATA['filter_order_id'        => $filter_order_id,]]></search>
			<add position="after"><![CDATA['filter_marketing_code'  => $filter_marketing_code,]]></add>
		</operation>
		<operation error="skip">
			<search ><![CDATA[$url .= '&filter_order_id=' . $this->request->get['filter_order_id'];]]></search>
			<add position="replace"><![CDATA[$url .= '&filter_order_id=' . $this->request->get['filter_order_id'];
		}
		if (isset($this->request->get['filter_marketing_code'])) {
			$url .= '&filter_marketing_code=' . $this->request->get['filter_marketing_code'];
		]]></add>
		</operation>
		<operation error="skip">
			<search ><![CDATA[$data['filter_order_id'] = $filter_order_id;]]></search>
			<add position="after"><![CDATA[
				$data['filter_marketing_code'] = $filter_marketing_code;
				]]></add>
		</operation>
	</file>


	<file path="admin/model/sale/order.php" error="skip"  info="Marketing Code Filter in order page">
		<operation error="skip">
			<search><![CDATA[$sql .= " AND o.total = '" . (float)$data['filter_total'] . "'";]]></search>
			<add position="replace"><![CDATA[
				$sql .= " AND o.total = '" . (float)$data['filter_total'] . "'";
				}if (!empty($data['filter_marketing_code'])) {
			$sql .= " AND o.tracking = '" . $data['filter_marketing_code'] . "'";
				]]></add>
		</operation>
		<operation error="skip">
			<search ><![CDATA[$sql .= " AND total = '" . (float)$data['filter_total'] . "'";]]></search>
			<add position="replace"><![CDATA[
				$sql .= " AND total = '" . (float)$data['filter_total'] . "'";
				}
				if (!empty($data['filter_marketing_code'])) {
			$sql .= " AND o.tracking = '" . $data['filter_marketing_code'] . "'";
				]]></add>
		</operation>
	</file>

	<file path="admin/language/en-gb/sale/order.php" error="skip"  info="Marketing Code Filter in order page">
		<operation error="skip">
			<search ><![CDATA[$_['entry_order_id']             = 'Order ID';]]></search>
			<add position="after"><![CDATA[
				$_['entry_marketing_code']		 = 'Marketing Code';
				]]></add>
		</operation>
	</file>
</modification>
