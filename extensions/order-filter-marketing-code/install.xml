<?xml version="1.0" encoding="utf-8"?>
<modification>
	<name>Order List Filter: Marketing Tracking Code</name>
	<code>order_filter_marketing_code</code>
	<version>1.1.0</version>
	<author>Shijin</author>
	<link>https://github.com/shijinb/opencart-extension-collection</link>

	<!--
		Adds a "Marketing Code" filter to Sales > Orders, to find orders placed through a marketing campaign link (index.php?tracking=CODE).
		Matches the order's "tracking" column exactly.
	-->
	<file path="admin/language/en-gb/sale/order.php">
		<operation>
			<search><![CDATA[$_['entry_order_id']]]></search>
			<add position="after"><![CDATA[$_['entry_marketing_code'] = 'Marketing Code';]]></add>
		</operation>
	</file>
	<file path="admin/view/template/sale/order_list.twig">
		<operation>
			<search index="0"><![CDATA[<div class="panel-body">]]></search>
			<add position="after"><![CDATA[            <div class="form-group">
              <label class="control-label" for="input-marketing_code">{{ entry_marketing_code }}</label>
              <input type="text" name="filter_marketing_code" value="{{ filter_marketing_code }}" placeholder="{{ entry_marketing_code }}" id="input-marketing_code" class="form-control" />
            </div>]]></add>
		</operation>
		<operation>
			<search><![CDATA[var filter_order_id = $('input[name=\'filter_order_id\']').val();]]></search>
			<add position="after"><![CDATA[
	var filter_marketing_code = $('input[name=\'filter_marketing_code\']').val();

	if (filter_marketing_code) {
		url += '&filter_marketing_code=' + encodeURIComponent(filter_marketing_code);
	}]]></add>
		</operation>
	</file>
	<file path="admin/controller/sale/order.php">
		<operation>
			<search><![CDATA[protected function getList() {]]></search>
			<add position="after"><![CDATA[		if (isset($this->request->get['filter_marketing_code'])) {
			$filter_marketing_code = $this->request->get['filter_marketing_code'];
		} else {
			$filter_marketing_code = '';
		}
]]></add>
		</operation>
		<operation>
			<search><![CDATA['filter_order_id'        => $filter_order_id,]]></search>
			<add position="after"><![CDATA[			'filter_marketing_code' => $filter_marketing_code,]]></add>
		</operation>
		<operation>
			<!-- Every place that rebuilds the list URL (sorting, pagination, back links) keeps the filter. -->
			<search><![CDATA[$url .= '&filter_order_id=' . $this->request->get['filter_order_id'];]]></search>
			<add position="replace"><![CDATA[$url .= '&filter_order_id=' . $this->request->get['filter_order_id'];
		}

		if (isset($this->request->get['filter_marketing_code'])) {
			$url .= '&filter_marketing_code=' . urlencode(html_entity_decode($this->request->get['filter_marketing_code'], ENT_QUOTES, 'UTF-8'));]]></add>
		</operation>
		<operation>
			<search><![CDATA[$data['filter_order_id'] = $filter_order_id;]]></search>
			<add position="after"><![CDATA[		$data['filter_marketing_code'] = $filter_marketing_code;]]></add>
		</operation>
	</file>
	<file path="admin/model/sale/order.php">
		<operation>
			<!-- getOrders(): the order table is aliased as "o". -->
			<search><![CDATA[$sql .= " AND o.total = '" . (float)$data['filter_total'] . "'";]]></search>
			<add position="after"><![CDATA[		}

		if (!empty($data['filter_marketing_code'])) {
			$sql .= " AND o.tracking = '" . $this->db->escape($data['filter_marketing_code']) . "'";]]></add>
		</operation>
		<operation>
			<!-- getTotalOrders() and getTotalSales(): no table alias. -->
			<search><![CDATA[$sql .= " AND total = '" . (float)$data['filter_total'] . "'";]]></search>
			<add position="after"><![CDATA[		}

		if (!empty($data['filter_marketing_code'])) {
			$sql .= " AND tracking = '" . $this->db->escape($data['filter_marketing_code']) . "'";]]></add>
		</operation>
	</file>
</modification>
